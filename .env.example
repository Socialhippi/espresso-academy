# Public
# The absolute origin, used for canonicals, Open Graph images and JSON-LD @ids.
# Leave it unset on a Vercel preview: the build falls back to NEXT_PUBLIC_VERCEL_URL, which Vercel
# sets to that deployment's own host. Set it explicitly for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional override for the WhatsApp number (digits with country code, no plus). Defaults to siteSettings.whatsappNumber
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Enquiry email (optional in the draft; without it the form hands off to WhatsApp)
RESEND_API_KEY=
LEAD_TO_EMAIL=
# MCP
CONTEXT7_API_KEY=
