# ─────────────────────────────────────────────────────────────────────────────
# Public. Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# The absolute origin, used for canonicals, Open Graph images and JSON-LD @ids.
# Leave it unset on a Vercel preview: the build falls back to NEXT_PUBLIC_VERCEL_URL, which Vercel
# sets to that deployment's own host. Set it explicitly for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" turns indexing on. Anything else sends X-Robots-Tag: noindex, nofollow on every response
# and makes robots.txt disallow everything. Flipping this is a launch-checklist step.
NEXT_PUBLIC_INDEXABLE=false

# Optional override for the WhatsApp number (digits with country code, no plus).
# Wins over the number in Sanity settings; use it to point a staging deployment at a test handset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─────────────────────────────────────────────────────────────────────────────
# Sanity: content, bookings and enquiries.
# The dataset is PRIVATE, because bookings and enquiries live in it, so even a published read
# needs the read token. Without the project id and dataset the site has no content and the build
# fails: that one is deliberate, not degraded.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-05
# Viewer role. Reads published content and, in draft mode, drafts.
SANITY_API_READ_TOKEN=
# Editor role. The only thing that may create a booking, move a seat count or read a fee for an
# order. Missing: enquiries fall back to email only and the booking routes render their TBC state.
SANITY_API_WRITE_TOKEN=
# Shared with the Sanity publish webhook; /api/revalidate rejects anything it cannot verify.
SANITY_REVALIDATE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay. Test keys until launch; switching to live keys is a runbook step.
# Missing: /book renders the enquire state and no Book button appears anywhere.
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# From the Razorpay dashboard when you add the webhook. Missing: the webhook returns 503 and the
# verify route is the only thing marking bookings paid.
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend). Missing: the enquiry form hands off to WhatsApp; a booking still completes.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Where enquiries go.
LEAD_TO_EMAIL=
# Where booking notifications go. Falls back to LEAD_TO_EMAIL.
BOOKING_TO_EMAIL=
# Where cafe and team enquiries go. Falls back to LEAD_TO_EMAIL.
CAFE_TO_EMAIL=
# The From: address. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets lead mirror (service account). Missing: skipped and logged; a lead is never lost,
# because Sanity is written first and the response depends only on that.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# The full PEM, newlines escaped as \n.
GOOGLE_SHEETS_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile. Missing: the widget is not rendered and verification is skipped; the
# honeypot and the time floor still apply.
# The 1x00000000000000000000AA / 1x0000000000000000000000000000000AA pair is Cloudflare's
# always-passes test key.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Analytics. Every one is optional; without them dataLayer is still pushed, so nothing throws.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Set while testing so events land in Meta's Test Events tab rather than in the live dataset.
META_TEST_EVENT_CODE=

# ─────────────────────────────────────────────────────────────────────────────
# Cal.com. Missing: the cafe thank-you page offers the WhatsApp button instead of an embed.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALCOM_LINK=

# ─────────────────────────────────────────────────────────────────────────────
# MCP, for local development only.
# ─────────────────────────────────────────────────────────────────────────────
CONTEXT7_API_KEY=
